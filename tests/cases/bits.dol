// std:bits（design.md 5.19）
@bits := import["std:bits"]
log[@bits.and[0b1100, 0b1010], @bits.or[0b1100, 0b1010], @bits.xor[0b1100, 0b1010]]
log[@bits.not[0], @bits.not[5], @bits.and[-1, 0xFF], @bits.or[-8, 3]]
log[@bits.shl[1, 10], @bits.shl[1, 52], @bits.shr[1024, 3], @bits.shr[-16, 2]]
log[@bits.popcount[0], @bits.popcount[255], @bits.popcount[0x1FFFFFFFFFFFFF]]

// 例: FNV-1a 風のハッシュと、フラグの操作
@flags := 0
@flags = @bits.or[@flags, @bits.shl[1, 3]]
@flags = @bits.or[@flags, @bits.shl[1, 0]]
log[@flags, @bits.and[@flags, @bits.shl[1, 3]] != 0, @bits.and[@flags, @bits.shl[1, 2]] != 0]
@flags = @bits.and[@flags, @bits.not[@bits.shl[1, 3]]]
log[@flags]
