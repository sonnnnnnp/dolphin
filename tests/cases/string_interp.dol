// 文字列の式展開と生の文字列（design.md 5.19）
@a := 3
@b := 4
@name := "イルカ"
@m := {"k": "v", "n": {1, 2}}
log["@a + @b = @{@a + @b}"]
log["こんにちは、@{str_upper["abc"]}さん"]
log["@{@m.k}と@{@m{"n"}{1}}と@{arr_len[@m.n] * 10}"]
log["入れ子: @{"[@{@a * 2}]"}"]
log["@{if @a > 2 ( "大" ) else ( "小" )}"]
log["括弧 @{ {1, 2}{0} } と @{ {"x": 5}.x }"]
log["先頭@{@a}末尾", "@{@a}@{@b}", "@{""}"]
log["複数行
@{@a}行目"]
log["エスケープ: \@{@a} と \@name と @ と @@a"]

log[r"C:\path\n @a @{x} "]
log[r#"引用 "ここ" と \n"#]
log[r##"# と "# を含む"##]
log[r"" == "", str_len[r"\"]]
// 関数名が r の呼び出しは今までどおり
r[@x] (
    # @x + 1
)
log[r[1]]
