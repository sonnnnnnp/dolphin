// スコープ: ( ) のブロックと関数ごとに 1 つ。宣言は :=、代入は =
@x := 1
if true (
    // 外側の @x を書き換える
    @x = 2
    // 内側で宣言すると、外側の @x を隠す
    @x := 100
    @x = @x + 1
    log["inner", @x]
)
log["outer", @x]

// while の本体は繰り返しごとに新しいスコープ
@i := 0
while @i < 3 (
    @sq := @i * @i
    @i = @i + 1
)
log[@i]

// 関数からは、ファイルのトップレベルの変数を読み書きできる（宣言が後ろにあってもよい）
bump[] (
    @counter = @counter + 1
    # @counter
)
@counter := 10
log[bump[], bump[], @counter]

// 関数の引数と変数は、呼び出しごとに別
shadow[@x] (
    @x = @x * 2
    @y := @x + 1
    # @y
)
log[shadow[5], @x]

// 自分自身を使って宣言すると、右辺は宣言する前の外側の変数を指す
if true (
    @x := @x + 1
    log[@x]
)
log[@x]
