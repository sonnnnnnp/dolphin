@json := import["std:json"]
log[@json.stringify[{1234567890123456789i, 1, 2.5}]]
@a := @json.parse["[12345678901234567, 1, 2.5, 1e2]"]
log[@a, type_of[@a{0}]]
@b := @json.parse["[12345678901234567, 1, 2.5, 1e2]", {"int": true}]
log[@b, type_of[@b{0}], type_of[@b{2}], type_of[@b{3}], @b{0} + 1i]
log[@json.parse["{\"id\": 9223372036854775807}", {"int": true}]{"id"}]
log[is_error[@json.parse["9223372036854775808", {"int": true}]]]
